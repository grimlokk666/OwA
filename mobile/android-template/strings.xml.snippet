<!--
  Merge into android/app/src/main/res/values/strings.xml
  Android 10+ background location rationale (shown in system dialogs).
-->
<resources>
    <string name="app_name">Sovereign Overwatch</string>
    <string name="title_activity_main">Sovereign Overwatch</string>
    <string name="package_name">d.sovereign.overwatch</string>
    <string name="custom_url_scheme">d.sovereign.overwatch</string>
    <string name="location_permission_rationale">
        Overwatch uses precise location to report this device as a private telemetry
        node to your self-hosted server over Tailscale. Data never leaves your mesh.
    </string>
</resources>
