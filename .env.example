# Sovereign Overwatch — local secrets (never commit .env)
# Copy to .env and fill values for your Tailscale mesh / home lab.

# Optional Discord alert webhook (leave empty for pure local-first)
DISCORD_WEBHOOK_URL=

# Optional AES-256-GCM shared key (base64 of 32 raw bytes) for /api/telemetry
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
TELEMETRY_ENCRYPTION_KEY=

# CORS — keep * on Tailscale-only mesh, or pin to your MagicDNS frontend origin
CORS_ORIGINS=*
