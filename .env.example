# Sovereign Overwatch — copy to .env (never commit .env)
# Public repository: do not put real secrets, tailnet hostnames, or keystores here.

# Shared secret for POST /api/alert and the read endpoints
# (/api/telemetry/latest, /api/pois, /api/cameras, /api/adsb, /api/scanner).
# Clients send it as the header X-Overwatch-Token.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ALERT_TOKEN=

# AES-256-GCM key (base64 of 32 raw bytes). Required while TELEMETRY_REQUIRE_KEY=true.
# Plaintext /api/telemetry posts are rejected. An envelope with no key configured
# is rejected (nothing is stored at 0,0).
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
TELEMETRY_ENCRYPTION_KEY=

# Reject non-envelope telemetry when true (default). Set false only on a trusted mesh.
TELEMETRY_REQUIRE_KEY=true

# Comma-separated browser origins allowed to call the API.
# Pin the dashboard origin you actually open. Do not use *.
# Must match FRONTEND_PORT (default dashboard origin below).
CORS_ORIGINS=http://127.0.0.1:3012

# Optional Discord webhook for accepted alerts. Leave empty to skip.
DISCORD_WEBHOOK_URL=

# Host ports published on 127.0.0.1 only, so this stack does not grab port 80.
# Reach the box from other machines with a reverse proxy or Tailscale Serve
# pointed at these localhost ports.
BACKEND_PORT=8001
FRONTEND_PORT=3012

# SQLite path inside the backend container. Compose sets this; change it only
# when running uvicorn outside Docker.
# DATABASE_URL=sqlite:////app/data/overwatch.db

# Directory for daily SQLite backups. Inside compose this is /backups,
# bind-mounted from ./backups on the host. Outside Docker it defaults to
# a backups/ folder next to the database file.
BACKUP_DIR=/backups

# Delete telemetry rows older than this many days. 0 keeps everything.
TELEMETRY_RETENTION_DAYS=365

# Delete cached POI rows older than this many days. 0 keeps everything.
POI_CACHE_DAYS=30

# How many daily SQLite backup files to keep.
BACKUP_KEEP=14

# Timezone for container logs and backup day-stamps.
TZ=UTC

# Local dump1090/readsb aircraft.json. Leave empty when you have no receiver:
# the ADS-B panel then says "no receiver configured" and the API returns 200.
# 127.0.0.1 inside the backend container is the container itself, not the host.
# Example: DUMP1090_URL=http://host.docker.internal:8080/data/aircraft.json
DUMP1090_URL=

# Optional OHGO public API key for Ohio traffic cameras.
# Register at https://publicapi.ohgo.com/ — leave empty to show no cameras.
# Snapshots are proxied at /api/cameras/{id}/snap and the catalog is cached 120s.
OHGO_API_KEY=
OHGO_API_URL=https://publicapi.ohgo.com/api/v1/cameras

# OwnTracks HTTP ingest (POST /api/tracking/owntracks).
# iPhone sends this as the password in the URL (HTTP Basic). Other clients may
# send Authorization: Bearer <token>. Generate a URL-safe token:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
OWNTRACKS_TOKEN=

# Optional navigation profile (docker compose --profile nav).
# Compose points these at the nav containers. Leave the defaults when using compose.
# Clear them only if you run the API outside Docker and have no local router/geocoder.
NOMINATIM_URL=http://overwatch-nominatim:8080
VALHALLA_URL=http://overwatch-valhalla:8002
VALHALLA_PORT=8002
NOMINATIM_PORT=8089
TILES_PORT=8090
# Nominatim import threads. Lower this on a small machine.
NOMINATIM_THREADS=4

# Optional scanner stream URL. Empty reports scanner status UNCONFIGURED.
SCANNER_STREAM_URL=

# Set to 1 to skip the background feed loop and the daily maintenance task
# (used by tests). Leave unset in normal deploys.
# OVERWATCH_DISABLE_WORKERS=

# Capacitor build only (not read by the API). HTTPS URL baked into the native
# shell. Leave empty to configure the URL in the app. Cleartext HTTP is disabled.
SOVEREIGN_DASHBOARD_URL=
